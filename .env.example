# BetterHRBUST 容器化部署配置示例
# 复制为根目录 .env 后按需修改（.env 已被 .gitignore 忽略，不会入库）。

# 管理端令牌签名密钥：务必替换为足够长的随机串，例如
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=please-change-this-to-a-long-random-secret

# 管理端登录有效期（小时）
JWT_TTL_HOURS=12

# MongoDB 数据库名
MONGO_DB=betterhrbust

# 对外映射端口
SERVER_PORT=9191
WEB_PORT=8080

# 反向代理网段（web 容器内的 nginx），限流按真实来源 IP 统计
TRUSTED_PROXIES=172.16.0.0/12

# 反馈提交限流开关（依赖 Redis，Redis 不可用时自动降级放行）
RATE_LIMIT_ENABLED=true
