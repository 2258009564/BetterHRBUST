# BetterHRBUST 容器化部署配置示例
# 复制为根目录 .env 后按需修改（.env 已被 .gitignore 忽略，不会入库）。
#
# 服务端配置（JWT_SECRET、MongoDB、Redis、SMTP 等）统一在 server/.env，
# 由 docker-compose.yml 通过 env_file 注入容器，这里不再重复配置。
# 本文件只保留 compose 自己的变量，不填则使用 docker-compose.yml 中的默认值。

# 对外映射端口
SERVER_PORT=9191
WEB_PORT=8080

# 可选：容器内信任的反向代理网段（web 容器内的 nginx），
# 不填时 compose 默认使用 172.16.0.0/12（Docker 内网网段）。
# TRUSTED_PROXIES=172.16.0.0/12
