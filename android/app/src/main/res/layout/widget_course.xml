<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_course_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="14dp">
    <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/widget_time_pill" android:clipToOutline="true">
    <TextView android:id="@+id/widget_course_detail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="3dp" android:paddingBottom="3dp"  android:background="@drawable/widget_time_pill" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_accent" android:maxLines="1" android:ellipsize="end"/>
    </FrameLayout>
    <TextView android:id="@+id/widget_course_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_text" android:maxLines="20"/>
    <TextView android:id="@+id/widget_course_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="11sp" android:textColor="@color/widget_secondary" android:maxLines="20"/>
</LinearLayout>
