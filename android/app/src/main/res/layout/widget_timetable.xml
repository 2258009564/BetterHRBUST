<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_surface">
    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_heading" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/widget_label" android:textColor="@color/widget_secondary" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/widget_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_secondary" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:layout_marginTop="14dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:id="@+id/widget_today_panel" android:padding="10dp" android:background="@drawable/widget_today_panel">
            <TextView android:id="@+id/widget_today_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_today" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_text" android:maxLines="1"/>
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp">
                <ListView android:id="@+id/widget_courses" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@null" android:dividerHeight="0dp" android:scrollbars="vertical" android:scrollbarStyle="insideOverlay" android:clipToPadding="false"/>
                <include android:id="@+id/widget_today_empty" layout="@layout/widget_empty_today" android:layout_width="match_parent" android:layout_height="match_parent"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_column_gap" android:layout_width="10dp" android:layout_height="match_parent" android:orientation="vertical"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:id="@+id/widget_tomorrow_panel" android:padding="10dp" android:background="@drawable/widget_tomorrow_panel">
            <TextView android:id="@+id/widget_tomorrow_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_tomorrow" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_text" android:maxLines="1"/>
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp">
                <ListView android:id="@+id/widget_tomorrow_courses" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@null" android:dividerHeight="0dp" android:scrollbars="vertical" android:scrollbarStyle="insideOverlay" android:clipToPadding="false"/>
                <include android:id="@+id/widget_tomorrow_empty" layout="@layout/widget_empty_tomorrow" android:layout_width="match_parent" android:layout_height="match_parent"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_footer_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_footer" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/widget_secondary" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/widget_done" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/widget_text" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:maxLines="1"/>
    </LinearLayout>
</LinearLayout>
